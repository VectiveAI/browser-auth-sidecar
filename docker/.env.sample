# Browser Auth Sidecar — Environment Variables
# Copy to .env and customize.

# Required: VNC password for noVNC web access
BAS_VNC_PASSWORD=changeme

# Optional: Container name prefix (default: browser-auth)
# BAS_CONTAINER_PREFIX=browser-auth

# Optional: noVNC port on host (default: 6901)
# BAS_NOVNC_PORT=6901

# Optional: CDP proxy port exposed via socat (default: 9223)
# BAS_CDP_PORT=9223

# Optional: Host path for Chrome profile persistence (default: ./data/kasm-profile)
# BAS_PROFILE_DIR=./data/kasm-profile

# Optional: Shared directory for session data, health metadata, audit logs (default: ./data/shared)
# BAS_SHARED_DIR=./data/shared

# Optional: Docker network name (default: browser-auth-net)
# BAS_NETWORK=browser-auth-net
