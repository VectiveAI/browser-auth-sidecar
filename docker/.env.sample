# Browser Auth Sidecar — Environment Variables
# Copy to .env and customize.

# Required: VNC password for noVNC web access
BAS_VNC_PASSWORD=changeme

# Optional: Container name prefix (default: browser-auth)
# BAS_CONTAINER_PREFIX=browser-auth

# Optional: noVNC port on host (default: 6901)
# BAS_NOVNC_PORT=6901

# Optional: CDP proxy port exposed by the grants-aware proxy (default: 9223)
# BAS_CDP_PORT=9223

# Optional: Host path for Chrome profile persistence (default: ./data/kasm-profile)
# BAS_PROFILE_DIR=./data/kasm-profile

# Optional: Shared directory for session data, health metadata, audit logs (default: ./data/shared)
# BAS_SHARED_DIR=./data/shared

# Optional: Docker network name (default: browser-auth-net)
# BAS_NETWORK=browser-auth-net

# --- Grants (per-agent CDP access) ---
#
# Docker mode's cdp-proxy validates every connection against a live grants
# index it polls from Maestro -- there is no local grants file. Two values
# are required before it will authorize anything:
#
# Required: the provider_id this host was issued when registered as a
# Maestro provider (see docs/architecture.md "Grants (per-agent CDP access)").
# No default -- until this is set, the proxy runs and simply refuses every
# connection rather than falling back to anything.
# BAS_MAESTRO_PROVIDER_ID=

# Required: the SAME connection credential minted at that registration --
# not a separate secret. This is what the proxy presents (as a Bearer
# token) when it polls Maestro for its own grants; Maestro uses it to
# confirm the poll is coming from the provider it claims to be, which is
# also what stops one provider from reading another's grants.
#
# Never put the actual value in .env. Inject it the same way
# BAS_VNC_PASSWORD is injected here -- read from a jack-owned file under
# ~/.secrets at compose time via stack-config.sh, never written to disk in
# plaintext as a .env value. This line only documents the variable's name.
# BAS_MAESTRO_PROVIDER_TOKEN=

# Optional: Maestro API base URL (default: https://maestro.vectiveai.com)
# BAS_MAESTRO_API_URL=https://maestro.vectiveai.com

# Optional: how often the proxy polls Maestro for its grants, in seconds
# (default: 1 -- matches the original file-mtime-poll design's cadence)
# BAS_GRANTS_POLL_INTERVAL=1
